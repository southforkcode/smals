if(NOT FILES OR NOT EXISTS "${TOOL}")
  message(FATAL_ERROR "Quality checks require nonempty files and an available tool")
endif()
foreach(input IN LISTS FILES)
  if(MODE STREQUAL "lint")
    set(args "${input}" "-p=${BUILD_DIR}" "--checks=-*,clang-analyzer-*" "--warnings-as-errors=*")
  elseif(MODE STREQUAL "format-fix")
    set(args -i "${input}")
  elseif(MODE STREQUAL "format-check")
    set(args --dry-run --Werror "${input}")
  else()
    message(FATAL_ERROR "Unknown quality mode: ${MODE}")
  endif()
  execute_process(COMMAND "${TOOL}" ${args} RESULT_VARIABLE status)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "${MODE} rejected ${input}: ${status}")
  endif()
endforeach()
