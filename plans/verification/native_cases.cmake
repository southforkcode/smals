# Process-only increment mappings; domain cases remain in test support.
foreach(entry "version|B002;B006;B013" "diagnostics|B005;B006" "command.reject|B005;B006" "trace.records|B007" "runtime.guards|B011" "logging.records|B015;B015.1;B015.2")
  string(REPLACE "|" ";" fields "${entry}")
  list(POP_FRONT fields domain)
  string(REPLACE "." "_" name "${domain}")
  add_test(NAME "case_${name}" COMMAND smil_tests --case "${domain}" --seed 17)
  set_tests_properties("case_${name}" PROPERTIES LABELS "${fields}" TIMEOUT 120)
endforeach()
foreach(entry "test_proof|B008;B008.1" "test_audit|B009;B009.1" "test_inventory|B010" "test_policy|B012" "test_shards|B013")
  string(REPLACE "|" ";" fields "${entry}")
  list(POP_FRONT fields module)
  add_test(NAME "tools_${module}" COMMAND "${SMIL_UV}" run --locked python -m unittest "tools.tests.${module}")
  set_tests_properties("tools_${module}" PROPERTIES LABELS "${fields}" TIMEOUT 120 WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
endforeach()
