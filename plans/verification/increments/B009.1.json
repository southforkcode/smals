{
  "schema": "smals.increment.v1",
  "increment": "B009.1",
  "targets": [
    "quality",
    "smil_tests"
  ],
  "build_dir": "build/smil",
  "inputs": [
    "CMakeLists.txt",
    "src/**/*.cpp",
    "src/**/*.hpp",
    "test/**/*.cpp",
    "test/**/*.hpp",
    "scripts/**/*.py",
    "tools/**/*.py",
    "tools/cmake/*.cmake",
    ".python-version",
    ".clang-format",
    ".clang-tidy",
    "specs/GLOSSARY.md",
    "pyproject.toml",
    "uv.lock",
    "plans/11_requirement_matrix.md"
  ],
  "cases": [
    {
      "id": "proof.regression",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "tools.tests.test_proof"
      ],
      "timeout_seconds": 120,
      "expected_exit": 0,
      "stderr_contains": [
        "OK"
      ]
    },
    {
      "id": "audit.behavior",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "tools.tests.test_audit"
      ],
      "timeout_seconds": 120,
      "expected_exit": 0,
      "stderr_contains": [
        "OK"
      ]
    }
  ]
}
