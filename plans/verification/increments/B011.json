{
  "schema": "smals.increment.v1",
  "increment": "B011",
  "targets": [
    "quality",
    "smil_tests"
  ],
  "build_dir": "build/smil",
  "inputs": [
    "CMakeLists.txt",
    "src/**/*.cpp",
    "src/**/*.hpp",
    "test/**/*.cpp",
    "test/**/*.hpp",
    "scripts/**/*.py",
    "tools/**/*.py",
    "tools/cmake/*.cmake",
    ".python-version",
    ".clang-format",
    ".clang-tidy",
    "specs/GLOSSARY.md",
    "pyproject.toml",
    "uv.lock",
    "plans/11_requirement_matrix.md",
    "plans/verification/requirements/*.json"
  ],
  "cases": [
    {
      "id": "runtime.guards",
      "argv": [
        "{build}/smil_tests",
        "--case",
        "runtime.guards",
        "--seed",
        "{seed}"
      ],
      "timeout_seconds": 10,
      "expected_exit": 0,
      "stdout_contains": [
        "case=runtime.guards",
        "expected=accept observed=accept"
      ]
    }
  ]
}
