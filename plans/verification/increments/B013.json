{
  "schema": "smals.increment.v1",
  "increment": "B013",
  "targets": [
    "quality",
    "smil_tests"
  ],
  "build_dir": "build/smil",
  "inputs": [
    "CMakeLists.txt",
    "src/**/*.cpp",
    "src/**/*.hpp",
    "test/**/*.cpp",
    "test/**/*.hpp",
    "scripts/**/*.py",
    "tools/**/*.py",
    "tools/cmake/*.cmake",
    ".python-version",
    ".clang-format",
    ".clang-tidy",
    "specs/GLOSSARY.md",
    "pyproject.toml",
    "uv.lock",
    "plans/11_requirement_matrix.md",
    "plans/verification/requirements/*.json",
    "plans/verification/native_cases.cmake"
  ],
  "cases": [
    {
      "id": "smoke.version",
      "case_set": "smoke",
      "argv": [
        "{build}/smil_tests",
        "--case",
        "version",
        "--seed",
        "{seed}"
      ],
      "timeout_seconds": 10,
      "expected_exit": 0,
      "stdout_contains": [
        "case=version",
        "expected=accept observed=accept"
      ]
    },
    {
      "id": "smoke.diagnostics",
      "case_set": "smoke",
      "argv": [
        "{build}/smil_tests",
        "--case",
        "diagnostics"
      ],
      "timeout_seconds": 10,
      "expected_exit": 0,
      "stdout_contains": [
        "case=diagnostics",
        "expected=accept observed=accept"
      ]
    },
    {
      "id": "shards.behavior",
      "case_set": "tools",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "tools.tests.test_shards"
      ],
      "timeout_seconds": 60,
      "expected_exit": 0,
      "stderr_contains": [
        "OK"
      ]
    }
  ]
}
