{
  "schema": "smals.increment.v1",
  "increment": "B015.1",
  "targets": [
    "smil_tests",
    "smil"
  ],
  "build_dir": "build/smil",
  "inputs": [
    "CMakeLists.txt",
    "src/**/*.cpp",
    "src/**/*.hpp",
    "test/**/*.cpp",
    "test/**/*.hpp",
    "scripts/**/*.py",
    "tools/**/*.py",
    "tools/cmake/*.cmake",
    ".python-version",
    ".clang-format",
    ".clang-tidy",
    "specs/GLOSSARY.md",
    "pyproject.toml",
    "uv.lock",
    "plans/11_requirement_matrix.md",
    "plans/verification/requirements/*.json",
    "plans/verification/native_cases.cmake",
    "examples/answer.smil",
    "examples/commands.json"
  ],
  "cases": [
    {
      "id": "logging.records",
      "argv": [
        "{build}/smil_tests",
        "--case",
        "logging.records",
        "--seed",
        "17"
      ],
      "timeout_seconds": 10,
      "expected_exit": 0,
      "stdout_contains": [
        "observed=accept"
      ]
    },
    {
      "id": "logging.origins",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "tools.tests.test_logging",
        "tools.tests.test_cli",
        "tools.tests.test_example"
      ],
      "timeout_seconds": 20,
      "expected_exit": 0,
      "stderr_contains": [
        "OK"
      ]
    }
  ]
}
